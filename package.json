{
  "name": "errorwise",
  "displayName": "Errorwise: Errors in Plain English",
  "description": "Turns confusing error messages into plain-language steps with everyday metaphors. Built for people learning to code.",
  "version": "0.1.1",
  "publisher": "jarvisappleslice",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JarvisAppleSlice/errorwise.git"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#127E86",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Education",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "beginner",
    "errors",
    "learning",
    "explain",
    "python",
    "javascript",
    "typescript",
    "csharp",
    "traceback",
    "teaching"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "errorwise.explainAtCursor",
        "title": "Errorwise: Explain the error at my cursor",
        "icon": "$(mortar-board)"
      },
      {
        "command": "errorwise.explainText",
        "title": "Errorwise: Explain selected text or a copied error"
      },
      {
        "command": "errorwise.explainTerminalSelection",
        "title": "Errorwise: Explain this error"
      },
      {
        "command": "errorwise.explainDiagnostic",
        "title": "Explain this error simply",
        "category": "Errorwise"
      },
      {
        "command": "errorwise.setApiKey",
        "title": "Errorwise: Add an Anthropic API key"
      },
      {
        "command": "errorwise.removeApiKey",
        "title": "Errorwise: Remove the Anthropic API key"
      },
      {
        "command": "errorwise.copyUnmatched",
        "title": "Errorwise: Copy errors that had no guide"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "errorwise.explainDiagnostic",
          "when": "false"
        },
        {
          "command": "errorwise.explainTerminalSelection",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "errorwise.explainAtCursor",
          "group": "navigation@100"
        },
        {
          "command": "errorwise.explainText",
          "when": "editorHasSelection",
          "group": "navigation@101"
        }
      ],
      "terminal/context": [
        {
          "command": "errorwise.explainTerminalSelection",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "errorwise.explainAtCursor",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus"
      },
      {
        "command": "errorwise.explainTerminalSelection",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "terminalFocus && terminalTextSelected"
      }
    ],
    "configuration": {
      "title": "Errorwise",
      "properties": {
        "errorwise.useAI": {
          "type": "boolean",
          "default": true,
          "description": "Use an AI model (such as GitHub Copilot) to explain errors using your actual code. When off, or when no model is available, Errorwise uses its built-in explanations."
        },
        "errorwise.aiProvider": {
          "type": "string",
          "enum": [
            "auto",
            "copilot",
            "anthropic"
          ],
          "enumDescriptions": [
            "Use GitHub Copilot (or another AI model in VS Code) if there is one, otherwise your Anthropic API key if you added one.",
            "Only use GitHub Copilot or another AI model in VS Code.",
            "Only use your own Anthropic API key. Add it with the command \"Errorwise: Add an Anthropic API key\"."
          ],
          "default": "auto",
          "description": "Which AI writes the tailored explanations."
        },
        "errorwise.anthropicModel": {
          "type": "string",
          "default": "claude-opus-5-5",
          "markdownDescription": "The Claude model used with your own Anthropic API key. Each explanation is billed to your Anthropic account. `claude-opus-5-5` gives the best explanations; `claude-sonnet-5-5` or `claude-haiku-4-5` cost less."
        },
        "errorwise.experienceLevel": {
          "type": "string",
          "enum": [
            "brand new",
            "a few months"
          ],
          "enumDescriptions": [
            "Assume no programming knowledge. Explain every term.",
            "Assume the basics (variables, loops, functions) are known."
          ],
          "default": "brand new",
          "description": "How much coding experience to assume in explanations."
        },
        "errorwise.metaphorTheme": {
          "type": "string",
          "enum": [
            "anything relatable",
            "cooking and the kitchen",
            "sports",
            "video games",
            "school and the classroom",
            "building and construction",
            "cars and driving"
          ],
          "default": "anything relatable",
          "description": "Where AI metaphors should come from. Pick something you know well."
        },
        "errorwise.showHoverLink": {
          "type": "boolean",
          "default": true,
          "description": "Show an \"Explain simply\" link when you hover over an error."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node esbuild.js",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p ./ && node ./out/test/knowledge.test.js",
    "vscode:prepublish": "tsc -p ./ && node esbuild.js --production",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0"
  }
}
